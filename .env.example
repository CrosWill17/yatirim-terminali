# YATIRIM TERMİNALİ — Çevre Değişkenleri Şablonu
# Bu dosyayı `.env` olarak kopyalayın:  cp .env.example .env
# .env dosyası .gitignore'dadır — asla git'e commit etmeyin.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://PROJE_REFSINIZ.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# NOT: SUPABASE_SERVICE_ROLE_KEY uygulama tarafında (.env / Vercel) KULLANILMAZ.
# Bu anahtar tüm RLS kurallarını atlar — asla .env'ye, asla Vercel'e eklemeyin.
# Yalnızca GitHub Actions admin script'leri (fund-holdings-sync, twitter-sync) içindir;
# onlar için anahtarı GitHub Secrets'a ekleyin (Supabase Dashboard → API'den kopyalayın).
